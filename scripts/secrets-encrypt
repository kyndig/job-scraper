#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RECIPIENTS="$ROOT/deploy/age-recipients.txt"
SOURCE="${1:-$ROOT/.env}"
DEST="$ROOT/deploy/secrets.enc.env"

if ! command -v sops >/dev/null 2>&1; then
  echo "Install sops first (macOS: brew install age sops)." >&2
  exit 1
fi
if [[ ! -f "$SOURCE" ]]; then
  echo "Missing $SOURCE. Copy .env.example to .env, fill secrets, then re-run." >&2
  exit 1
fi
if [[ ! -f "$RECIPIENTS" ]]; then
  echo "Missing $RECIPIENTS." >&2
  exit 1
fi

ages=()
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    age1*) ages+=("$line") ;;
  esac
done <"$RECIPIENTS"

if [[ ${#ages[@]} -eq 0 ]]; then
  echo "No age1 public keys in $RECIPIENTS. Run ./scripts/secrets-keygen first." >&2
  exit 1
fi

age_csv="$(IFS=,; echo "${ages[*]}")"
sops --encrypt --age "$age_csv" --input-type dotenv --output-type dotenv "$SOURCE" >"$DEST"
echo "Wrote $DEST. Commit this file. Do not commit $SOURCE."
