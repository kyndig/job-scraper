#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KEY_DIR="${KOIS_AGE_DIR:-$HOME/.config/kois}"
KEY_FILE="${SOPS_AGE_KEY_FILE:-$KEY_DIR/age.key}"

if ! command -v age-keygen >/dev/null 2>&1; then
  echo "Install age first (macOS: brew install age sops)." >&2
  exit 1
fi

mkdir -p "$KEY_DIR"
chmod 700 "$KEY_DIR"
if [[ -f "$KEY_FILE" ]]; then
  echo "Age key already exists at $KEY_FILE"
else
  age-keygen -o "$KEY_FILE"
  chmod 600 "$KEY_FILE"
  echo "Wrote private key to $KEY_FILE"
fi

pubkey="$(age-keygen -y "$KEY_FILE")"
echo
echo "Public key (commit this to deploy/age-recipients.txt):"
echo "$pubkey"
echo
if ! grep -qF "$pubkey" "$ROOT/deploy/age-recipients.txt" 2>/dev/null; then
  echo "Add that line to deploy/age-recipients.txt, commit, and have an"
  echo "existing operator run ./scripts/secrets-encrypt so you can decrypt."
fi
