#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENC="$ROOT/deploy/secrets.enc.env"
DEST="$ROOT/.env"
KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/kois/age.key}"

if ! command -v sops >/dev/null 2>&1; then
  echo "Install sops first (macOS: brew install age sops)." >&2
  exit 1
fi
if [[ ! -f "$ENC" ]]; then
  echo "Missing $ENC. An operator must encrypt secrets once with ./scripts/secrets-encrypt." >&2
  exit 1
fi
if [[ ! -f "$KEY_FILE" ]]; then
  echo "Missing age private key at $KEY_FILE. Run ./scripts/secrets-keygen and get an operator to re-encrypt." >&2
  exit 1
fi

export SOPS_AGE_KEY_FILE="$KEY_FILE"
umask 077
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
sops --decrypt --input-type dotenv --output-type dotenv "$ENC" >"$tmp"

python3 - "$tmp" "$DEST" <<'PY'
import sys
from pathlib import Path
from urllib.parse import quote_plus

src, dest = Path(sys.argv[1]), Path(sys.argv[2])
values: dict[str, str] = {}
lines: list[str] = []
for raw in src.read_text(encoding="utf-8").splitlines():
    if not raw or raw.lstrip().startswith("#") or "=" not in raw:
        lines.append(raw)
        continue
    key, _, value = raw.partition("=")
    values[key] = value
    lines.append(raw)

user = values.get("KOIS_DB_USER") or "kois"
name = values.get("KOIS_DB_NAME") or "kois"
password = values.get("KOIS_DB_PASSWORD") or ""
url = values.get("DATABASE_URL") or ""
if password and (not url or "REPLACE" in url or url.endswith("://")):
    assembled = f"postgresql+psycopg://{quote_plus(user)}:{quote_plus(password)}@db:5432/{name}"
    replaced = False
    out: list[str] = []
    for line in lines:
        if line.startswith("DATABASE_URL="):
            out.append(f"DATABASE_URL={assembled}")
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(f"DATABASE_URL={assembled}")
    dest.write_text("\n".join(out) + "\n", encoding="utf-8")
else:
    dest.write_text(src.read_text(encoding="utf-8"), encoding="utf-8")
PY

chmod 600 "$DEST"
echo "Wrote $DEST (mode 600). This file stays gitignored."
