# Copy to .env on the host. Never commit real secrets.

# App database URL must use the Compose service hostname `db`.
DATABASE_URL=postgresql+psycopg://kois:kois@db:5432/kois
POSTGRES_USER=kois
POSTGRES_PASSWORD=kois
POSTGRES_DB=kois

# Shared secret for /ui and mutating API routes. Leave empty only on trusted loopback.
KOIS_REVIEW_TOKEN=change-me

# Email-first verification: skip broker scrapers until IMAP is confirmed.
KOIS_SKIP_SCRAPERS=true
RUN_LIVE_SLACK=false
SLACK_CHANNEL=job-posting
# SLACK_TOKEN=
# GEMINI_API_KEY=

# Single mailbox fallback (used when IMAP_ACCOUNTS_JSON is unset)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=oppdrag@kynd.no
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_SOURCE_NAME=oppdrag@kynd.no

# Multiple mailboxes. Each object needs host, username, password.
# IMAP_ACCOUNTS_JSON=[{"host":"imap.example.com","username":"oppdrag@kynd.no","password":"...","source_name":"oppdrag@kynd.no"}]

# Broker scrapers (enable after IMAP is verified; unset KOIS_SKIP_SCRAPERS)
# MERCELL_USERNAME=
# MERCELL_PASSWORD=
# VERAMA_USERNAME=
# VERAMA_PASSWORD=
# FOLQ_USERNAME=
# FOLQ_PASSWORD=
# EMAGINE_USERNAME=
# EMAGINE_PASSWORD=
# WITTED_USERNAME=
# WITTED_PASSWORD=

# Phase 3 filtering
# DIGEST_MODE=balanced
# DIGEST_MIN_RELEVANCE_SCORE=0.35
# DIGEST_MIN_SOURCE_CONFIDENCE=0.75
# DIGEST_CADENCE_MINUTES=0
# AVAILABILITY_PROFILE_JSON={"data_engineering":2,"backend":1}
