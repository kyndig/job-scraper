# Plaintext schema for KOIS secrets. Never commit a filled copy.
# Materialize a host .env with: ./scripts/secrets-decrypt
# First encrypt: fill this file as .env, then ./scripts/secrets-encrypt

# --- Database (required for Compose) ---
# Generate with: openssl rand -hex 32
POSTGRES_SUPERUSER_PASSWORD=
KOIS_DB_USER=kois
KOIS_DB_NAME=kois
KOIS_DB_PASSWORD=
# Assembled by ./scripts/secrets-decrypt if left empty:
# DATABASE_URL=postgresql+psycopg://kois:<KOIS_DB_PASSWORD>@db:5432/kois
DATABASE_URL=

# Shared secret for /ui and mutating API routes.
KOIS_REVIEW_TOKEN=

# Email-first verification: skip broker scrapers until IMAP is confirmed.
KOIS_SKIP_SCRAPERS=true
RUN_LIVE_SLACK=false
SLACK_CHANNEL=job-posting
# SLACK_TOKEN=

# LLM summaries are optional. Heuristic extraction works without a key.
# Set KOIS_LLM_PROVIDER when both keys exist; otherwise the present key is used.
# KOIS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# KOIS_LLM_PROVIDER=kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-turbo-preview

# Single mailbox fallback (used when IMAP_ACCOUNTS_JSON is unset)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=oppdrag@kynd.no
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_SOURCE_NAME=oppdrag@kynd.no

# Multiple mailboxes. Each object needs host, username, password.
# IMAP_ACCOUNTS_JSON=[{"host":"imap.example.com","username":"oppdrag@kynd.no","password":"...","source_name":"oppdrag@kynd.no"}]

# Broker scrapers (enable after IMAP is verified; set KOIS_SKIP_SCRAPERS=false)
# MERCELL_USERNAME=
# MERCELL_PASSWORD=
# VERAMA_USERNAME=
# VERAMA_PASSWORD=
# FOLQ_USERNAME=
# FOLQ_PASSWORD=
# EMAGINE_USERNAME=
# EMAGINE_PASSWORD=
# WITTED_USERNAME=
# WITTED_PASSWORD=

# Phase 3 filtering
# DIGEST_MODE=balanced
# DIGEST_MIN_RELEVANCE_SCORE=0.35
# DIGEST_MIN_SOURCE_CONFIDENCE=0.75
# DIGEST_CADENCE_MINUTES=0
# AVAILABILITY_PROFILE_JSON={"data_engineering":2,"backend":1}
